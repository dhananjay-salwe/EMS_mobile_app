{
  "cli": {
    "version": ">= 12.5.2"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "key": "voting-app-gradle-cache",
        "paths": [
          "~/.gradle/caches",
          "~/.gradle/wrapper",
          ".m2/repository"
        ]
      },
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.daemon=false -Dorg.gradle.parallel=true -Dorg.gradle.caching=true -Dorg.gradle.jvmargs=\"-Xmx4096m -XX:MaxMetaspaceSize=1024m\""
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "key": "voting-app-gradle-cache",
        "paths": [
          "~/.gradle/caches",
          "~/.gradle/wrapper",
          ".m2/repository"
        ]
      },
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.daemon=false -Dorg.gradle.parallel=true -Dorg.gradle.caching=true -Dorg.gradle.jvmargs=\"-Xmx4096m -XX:MaxMetaspaceSize=1024m\""
      }
    }
  },
  "submit": {
    "production": {}
  }
}